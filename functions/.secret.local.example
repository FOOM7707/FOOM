# 로컬 에뮬레이터 전용 시크릿
#
# 이 파일을 functions/.secret.local 로 복사한 뒤 값을 채우세요.
# .secret.local 은 커밋되지 않습니다(functions/.gitignore, 루트 .gitignore 양쪽).
#
# 운영 환경에는 이 파일을 쓰지 않고 Firebase 시크릿에 등록합니다:
#   firebase functions:secrets:set NAVER_CLIENT_SECRET
#
# ⚠️ VITE_ 접두사를 붙이지 마세요. Vite 는 VITE_ 로 시작하는 변수를 프론트엔드
#    번들에 그대로 인라인하므로, 붙는 순간 브라우저에서 누구나 읽을 수 있습니다.

NAVER_CLIENT_SECRET=

# 기상청(공공데이터포털) 인증키 — 스키마 16-3
#
# ⚠️ 「일반 인증키(Encoding)」가 아니라 **「일반 인증키(Decoding)」**를 넣으세요.
#    코드가 값을 한 번 인코딩하므로, 이미 인코딩된 키를 넣으면 이중 인코딩되어
#    "등록되지 않은 키(SERVICE_KEY_IS_NOT_REGISTERED_ERROR)"로 거부됩니다.
#    "키를 발급했는데 안 된다"의 대부분이 이 경우입니다.
KMA_SERVICE_KEY=
