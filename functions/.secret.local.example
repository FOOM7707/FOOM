# 로컬 에뮬레이터 전용 시크릿
#
# 이 파일을 functions/.secret.local 로 복사한 뒤 값을 채우세요.
# .secret.local 은 커밋되지 않습니다(functions/.gitignore, 루트 .gitignore 양쪽).
#
# 운영 환경에는 이 파일을 쓰지 않고 Firebase 시크릿에 등록합니다:
#   firebase functions:secrets:set NAVER_CLIENT_SECRET
#
# ⚠️ VITE_ 접두사를 붙이지 마세요. Vite 는 VITE_ 로 시작하는 변수를 프론트엔드
#    번들에 그대로 인라인하므로, 붙는 순간 브라우저에서 누구나 읽을 수 있습니다.

NAVER_CLIENT_SECRET=

# 기상청(공공데이터포털) 인증키 — 스키마 16-3
#
# ⚠️ 「일반 인증키(Encoding)」가 아니라 **「일반 인증키(Decoding)」**를 넣으세요.
#    코드가 값을 한 번 인코딩하므로, 이미 인코딩된 키를 넣으면 이중 인코딩되어
#    "등록되지 않은 키(SERVICE_KEY_IS_NOT_REGISTERED_ERROR)"로 거부됩니다.
#    "키를 발급했는데 안 된다"의 대부분이 이 경우입니다.
KMA_SERVICE_KEY=

# 카카오 REST API 키 — 서버 전용
#
# 쓰는 곳 두 가지:
#   ① 주소 → 좌표 지오코딩 (GET /external/kakao-map/search)
#   ② 카카오 로그인 토큰 교환 (비즈앱 심사 통과 후)
#
# ⚠️ 4종 중 **REST API 키**입니다.
#    - JavaScript 키는 프론트(.env 의 VITE_KAKAO_MAP_KEY)로 갑니다
#    - 네이티브 앱 키는 Android/iOS 전용이라 쓰지 않습니다
#    - **어드민 키는 앱 전권 키라 어디에도 넣지 않습니다.** 유출 시 회원 강제
#      탈퇴까지 가능하고 되돌릴 수 없습니다
KAKAO_REST_API_KEY=

# 카카오 로그인 Client Secret — **선택 값입니다.**
#
# 카카오 개발자센터 > 제품 설정 > 카카오 로그인 > 보안에서 발급하고
# 「사용함」으로 켠 경우에만 값을 넣습니다. **켜지 않았는데 넣으면 토큰 교환이
# 거부됩니다** — 그래서 코드는 값이 비어 있으면 파라미터 자체를 보내지 않습니다.
#
# 켜두면 인가코드가 새어나가도 남이 토큰으로 바꾸지 못합니다(네이버는 필수).
KAKAO_CLIENT_SECRET=
