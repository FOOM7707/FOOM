# 프론트엔드(Vite) 환경변수
#
# 이 파일을 .env 로 복사한 뒤 값을 채우세요. .env 는 커밋되지 않습니다.
#
# ⚠️ VITE_ 로 시작하는 값은 빌드 결과물에 그대로 들어가 브라우저에서 누구나
#    읽을 수 있습니다. 여기에는 **공개돼도 되는 값만** 넣으세요.
#    Client Secret 류는 절대 이 파일에 두지 않습니다 — functions/.secret.local
#    (로컬) 또는 Firebase 시크릿(운영)에 둡니다.

# 네이버 로그인 Client ID (공개 값)
VITE_NAVER_CLIENT_ID=

# ── Firebase 웹 설정 ────────────────────────────────────────────────────
# 비워두면 개발 모드에서 자동으로 에뮬레이터(demo-foom)에 붙습니다.
# 실서버(foom-4092d)에 붙일 때만 아래를 채우세요.
# 값은 Firebase 콘솔 > 프로젝트 설정 > 내 앱 에서 확인합니다.
# 전부 공개돼도 되는 값입니다 — 실제 차단은 보안규칙과 함수 진입부가 합니다.
#
# VITE_FIREBASE_USE_EMULATOR=false
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_STORAGE_BUCKET=

# ── 카카오맵 ────────────────────────────────────────────────────────────
# 카카오 개발자센터 > 플랫폼 키 > **JavaScript 키** (REST API 키 아님)
#
# 이 값은 공개돼도 되는 값입니다 — 브라우저가 카카오 서버에 직접 붙는 구조라
# 번들에 그대로 들어갑니다. 대신 같은 화면의 「JavaScript SDK 도메인」에
# 등록한 도메인에서만 동작하므로, 아래 두 개를 반드시 등록하세요.
#   http://localhost:5173      ← 127.0.0.1 은 다른 도메인으로 취급됩니다
#   https://(배포 도메인)
# 제품 설정에서 「카카오맵」 사용 설정도 ON 이어야 합니다.
VITE_KAKAO_MAP_KEY=
