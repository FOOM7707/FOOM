# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul
coverage
*.lcov
.nyc_output

# Dependency directories
node_modules/
jspm_packages/

# TypeScript cache
*.tsbuildinfo

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional stylelint cache
.stylelintcache

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variable files
.env
.env.*
!.env.example

# Firebase 시크릿 (로컬 에뮬레이터용 — 실제 키 값이 들어감)
# 아래 *.local 규칙에도 걸리지만, 실수로 그 줄이 지워져도 남도록 따로 적어둡니다.
.secret.local
**/.secret.local
!.secret.local.example

# Build output
dist
dist-ssr
*.local

# Firebase
.firebase/
*-debug.log

# Vite files
vite.config.js.timestamp-*
vite.config.ts.timestamp-*
.vite/

# pnpm
.pnpm-store

# yarn v3
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.vscode-test
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Claude Code 개인 설정
.claude/settings.local.json

# 에뮬레이터 데이터 백업(firebase emulators:export). 로컬 연습 데이터라 커밋하지 않습니다
firebase-export-*/

# 개발용 에뮬레이터 데이터 (`npm run emu`가 끌 때 저장하고 켤 때 불러옵니다).
# 계정·프로그램·사진이 들어 있어 리포에 올리지 않습니다.
# 별표(*)인 이유: 수동 백업(.emulator-data.bak-0824 등)까지 전부 덮기 위해서입니다.
.emulator-data*/
